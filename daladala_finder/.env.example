# Copy these into your server's environment variables (never commit real values to GitHub).

DJANGO_DEBUG=False
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=daladala.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://daladala.example.com

# PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgres://daladala:password@localhost:5432/daladala
# Use "require" if your database host needs SSL (most cloud databases do)
DATABASE_SSLMODE=prefer
